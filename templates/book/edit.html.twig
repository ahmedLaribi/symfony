<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Modifier un Livre</title>
    
</head>
<body>
<div class="form-container">
    <h1> Modifier le Livre</h1>
    <p style="text-align: center; color: #7f8c8d; margin-bottom: 20px;">
        Modification de: <strong>{{ book.title }}</strong>
    </p>

    {{ form_start(form) }}
    {{ form_row(form.title) }}
    {{ form_row(form.category) }}
    {{ form_row(form.publicationDate) }}
    {{ form_row(form.author) }}
    {{ form_row(form.submit, {'label': 'Mettre à jour'}) }}
    {{ form_end(form) }}

    <a href="{{ path('app_book_list') }}" class="back-link">
         Retour à la liste
    </a>
</div>
</body>
</html>