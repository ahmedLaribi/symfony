<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Ajouter un Auteur</title>
    
</head>
<body>
<div class="form-container">
    <h1> Ajouter un Auteur</h1>

    {{ form_start(form) }}
    {{ form_row(form.username) }}
    {{ form_row(form.email) }}
    {{ form_row(form.nb_books) }}
    {{ form_row(form.submit) }}
    {{ form_end(form) }}

    <a href="{{ path('app_author_list') }}" class="back-link">
         Retour à la liste
    </a>
</div>
</body>
</html>