{# templates/backoffice/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Backoffice{% endblock %}</title>
    
    {# Inclure les CSS du template #}
    <link rel="stylesheet" href="{{ asset('assets/css/styles.css') }}">
    
    {% block stylesheets %}{% endblock %}
</head>
<body>
    {# Header du backoffice #}
    <header class="backoffice-header">
        {% include 'backoffice/partials/_header.html.twig' %}
    </header>

    {# Navigation #}
    <nav class="backoffice-nav">
        {% include 'backoffice/partials/_sidebar.html.twig' %}
    </nav>

    {# Contenu principal #}
    <main class="backoffice-main">
        {% block body %}{% endblock %}
    </main>

    {# Footer #}
    <footer class="backoffice-footer">
        {% include 'backoffice/partials/_footer.html.twig' %}
    </footer>

    {# Scripts JavaScript #}
    <script src="{{ asset('assets/js/main.js') }}"></script>
    {% block javascripts %}{% endblock %}
</body>
</html>